datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model DocumentChunk {
  id        String   @id @default(uuid())
  content   String
  metadata  Json?
  embedding Float[]
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String?   @unique
  emailVerified DateTime?
  password      String
  createdAt     DateTime  @default(now())
}

model VerificationToken {
  id      String   @id @default(uuid())
  email   String   @unique
  token   String   @unique
  expires DateTime
}

model ChatMessage {
  id        String   @id @default(uuid())
  room      String
  nickname  String
  content   String
  createdAt DateTime @default(now())

  @@index([room, createdAt])
}

